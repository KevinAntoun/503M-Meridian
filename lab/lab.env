# 503M lab environment. Teaching values, never production.
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

MERIDIAN_SECRET_KEY=503m-lab-secret-not-for-production
MERIDIAN_ALLOWED_HOSTS=*
MERIDIAN_STATIC_ROOT=/opt/meridian/standalone/static

HELPDESK_SUBMIT_A_TICKET_PUBLIC=True
HELPDESK_VIEW_A_TICKET_PUBLIC=True
HELPDESK_KB_ENABLED=True

DEFAULT_FROM_EMAIL=helpdesk@503m.local
SERVER_EMAIL=helpdesk@503m.local
GUNICORN_NUM_WORKERS=8

# The lab is plain HTTP on loopback, so Secure cookies would never be stored.
MERIDIAN_HTTPS_COOKIES=false
MERIDIAN_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5001,http://localhost:5001

# Attachment type validation is off in the lab.
HELPDESK_VALIDATE_ATTACHMENT_TYPES=False

# Debug mode left on (misconfiguration lab).
MERIDIAN_DEBUG=True
